{
  "openapi": "3.0.3",
  "info": { "title": "肿瘤科智能检测门诊系统 API（zzt 29+V2 15=44接口）", "version": "2.0.0" },
  "servers": [{ "url": "http://127.0.0.1:8000/api", "description": "本地开发" }],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } }
  },
  "tags": [
    { "name": "认证模块", "description": "11 接口" },
    { "name": "患者端-预约管理", "description": "9 接口" },
    { "name": "患者端-AI文字诊断", "description": "5 接口" },
    { "name": "患者端-病历与处方", "description": "7 接口" },
    { "name": "医生端-病历与处方", "description": "12 接口" }
  ],
  "paths": {
    "/auth/register": { "post": { "tags": ["认证模块"], "summary": "患者注册", "security": [], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["name","email","password"], "properties": { "name": { "type": "string" }, "email": { "type": "string" }, "password": { "type": "string", "minLength": 6 }, "phone": { "type": "string" } } } } } }, "responses": { "200": { "description": "token" } } } },
    "/auth/login": { "post": { "tags": ["认证模块"], "summary": "用户登录", "security": [], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["email","password"], "properties": { "email": { "type": "string" }, "password": { "type": "string" } } } } } }, "responses": { "200": { "description": "token" } } } },
    "/auth/logout": { "post": { "tags": ["认证模块"], "summary": "退出登录", "responses": { "200": { "description": "ok" } } } },
    "/auth/me": { "get": { "tags": ["认证模块"], "summary": "获取当前用户信息", "responses": { "200": { "description": "用户信息" } } } },
    "/auth/password": { "put": { "tags": ["认证模块"], "summary": "修改密码", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["current_password","new_password","new_password_confirmation"], "properties": { "current_password": { "type": "string" }, "new_password": { "type": "string" }, "new_password_confirmation": { "type": "string" } } } } } }, "responses": { "200": { "description": "ok" } } } },
    "/auth/avatar": { "post": { "tags": ["认证模块"], "summary": "更换头像", "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["avatar"], "properties": { "avatar": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "头像URL" } } } },
    "/auth/profile": { "put": { "tags": ["认证模块"], "summary": "更新个人资料", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "phone": { "type": "string" }, "title": { "type": "string" }, "specialty": { "type": "string" }, "department": { "type": "string" }, "introduction": { "type": "string" }, "experience_years": { "type": "integer" } } } } } }, "responses": { "200": { "description": "ok" } } } },
    "/auth/forgot-password": { "post": { "tags": ["认证模块"], "summary": "忘记密码", "security": [], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string" } } } } } }, "responses": { "200": { "description": "重置令牌" } } } },
    "/auth/reset-password": { "post": { "tags": ["认证模块"], "summary": "重置密码", "security": [], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["email","token","password","password_confirmation"], "properties": { "email": { "type": "string" }, "token": { "type": "string" }, "password": { "type": "string" }, "password_confirmation": { "type": "string" } } } } } }, "responses": { "200": { "description": "ok" } } } },
    "/auth/verify-email": { "post": { "tags": ["认证模块"], "summary": "邮箱验证", "responses": { "200": { "description": "ok" } } } },
    "/auth/account": { "delete": { "tags": ["认证模块"], "summary": "账号注销", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["password"], "properties": { "password": { "type": "string" } } } } } }, "responses": { "200": { "description": "ok" } } } },
    "/patient/dashboard": { "get": { "tags": ["患者端-预约管理"], "summary": "患者首页统计", "responses": { "200": { "description": "待就诊/已完成/AI诊断/下次预约" } } } },
    "/patient/doctors": { "get": { "tags": ["患者端-预约管理"], "summary": "医生列表", "parameters": [{ "name": "keyword", "in": "query", "schema": { "type": "string" } }, { "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "per_page", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "分页" } } } },
    "/patient/doctors/{id}": { "get": { "tags": ["患者端-预约管理"], "summary": "医生详情", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "医生信息" } } } },
    "/patient/appointments": { "post": { "tags": ["患者端-预约管理"], "summary": "创建预约", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["doctor_id","appointment_date","appointment_time"], "properties": { "doctor_id": { "type": "integer" }, "appointment_date": { "type": "string", "format": "date" }, "appointment_time": { "type": "string" } } } } } }, "responses": { "200": { "description": "预约信息" } } }, "get": { "tags": ["患者端-预约管理"], "summary": "我的预约列表", "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string" } }, { "name": "date", "in": "query", "schema": { "type": "string" } }, { "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "per_page", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "分页" } } } },
    "/patient/appointments/available-slots": { "get": { "tags": ["患者端-预约管理"], "summary": "可预约时段", "parameters": [{ "name": "doctor_id", "in": "query", "required": true, "schema": { "type": "integer" } }, { "name": "date", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "可用时段列表" } } } },
    "/patient/appointments/{id}": { "get": { "tags": ["患者端-预约管理"], "summary": "预约详情", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "预约+病历+处方+AI" } } }, "delete": { "tags": ["患者端-预约管理"], "summary": "取消预约", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "ok" } } } },
    "/patient/appointments/{id}/review": { "post": { "tags": ["患者端-预约管理"], "summary": "就诊评价", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["rating"], "properties": { "rating": { "type": "integer", "minimum": 1, "maximum": 5 }, "content": { "type": "string" } } } } } }, "responses": { "200": { "description": "ok" } } } },
    "/patient/ai-diagnosis": { "post": { "tags": ["患者端-AI文字诊断"], "summary": "AI文字智能诊断", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["symptom_description"], "properties": { "symptom_description": { "type": "string" }, "appointment_id": { "type": "integer" } } } } } }, "responses": { "200": { "description": "诊断报告" } } }, "get": { "tags": ["患者端-AI文字诊断"], "summary": "AI诊断记录列表", "parameters": [{ "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "per_page", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "分页" } } } },
    "/patient/ai-diagnosis/continue": { "post": { "tags": ["患者端-AI文字诊断"], "summary": "AI诊断追问（多轮对话）", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["diagnosis_id","question"], "properties": { "diagnosis_id": { "type": "integer" }, "question": { "type": "string" } } } } } }, "responses": { "200": { "description": "追问回复" } } } },
    "/patient/ai-diagnosis/{id}": { "get": { "tags": ["患者端-AI文字诊断"], "summary": "AI诊断报告详情", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "完整报告" } } } },
    "/patient/ai-diagnosis/{id}/export": { "get": { "tags": ["患者端-AI文字诊断"], "summary": "导出PDF诊断报告", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "报告导出数据" } } } },
    "/patient/medical-records": { "get": { "tags": ["患者端-病历与处方"], "summary": "我的病历列表", "parameters": [{ "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "per_page", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "分页" } } } },
    "/patient/medical-records/{id}": { "get": { "tags": ["患者端-病历与处方"], "summary": "病历详情", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "病历+医生+预约" } } } },
    "/patient/prescriptions": { "get": { "tags": ["患者端-病历与处方"], "summary": "我的处方列表", "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string" } }, { "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "per_page", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "分页" } } } },
    "/patient/prescriptions/{id}": { "get": { "tags": ["患者端-病历与处方"], "summary": "处方详情", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "处方+明细" } } } },
    "/patient/prescriptions/{id}/confirm": { "post": { "tags": ["患者端-病历与处方"], "summary": "确认取药", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "取药成功" } } } },
    "/patient/prescriptions/{id}/refill": { "post": { "tags": ["患者端-病历与处方"], "summary": "处方续方申请", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "续方申请已提交" } } } },
    "/patient/medication-reminders": { "get": { "tags": ["患者端-病历与处方"], "summary": "每日用药提醒列表", "responses": { "200": { "description": "用药提醒" } } } },
    "/doctor/medical-records": { "post": { "tags": ["医生端-病历与处方"], "summary": "创建病历", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["appointment_id","symptoms","preliminary_diagnosis","treatment_plan"], "properties": { "appointment_id": { "type": "integer" }, "symptoms": { "type": "string" }, "imaging_findings": { "type": "string" }, "preliminary_diagnosis": { "type": "string" }, "treatment_plan": { "type": "string" } } } } } }, "responses": { "200": { "description": "病历" } } }, "get": { "tags": ["医生端-病历与处方"], "summary": "历史病历列表", "parameters": [{ "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "per_page", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "分页" } } } },
    "/doctor/medical-records/compare": { "get": { "tags": ["医生端-病历与处方"], "summary": "多份病历对比", "parameters": [{ "name": "ids", "in": "query", "required": true, "schema": { "type": "string" }, "description": "逗号分隔病历ID" }], "responses": { "200": { "description": "对比结果" } } } },
    "/doctor/medical-records/{id}": { "put": { "tags": ["医生端-病历与处方"], "summary": "编辑病历", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "symptoms": { "type": "string" }, "imaging_findings": { "type": "string" }, "preliminary_diagnosis": { "type": "string" }, "treatment_plan": { "type": "string" } } } } } }, "responses": { "200": { "description": "ok" } } }, "get": { "tags": ["医生端-病历与处方"], "summary": "查看病历详情", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "病历+患者+预约" } } } },
    "/doctor/prescriptions": { "post": { "tags": ["医生端-病历与处方"], "summary": "开具处方", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["appointment_id","items"], "properties": { "appointment_id": { "type": "integer" }, "items": { "type": "array", "items": { "type": "object", "required": ["drug_id","quantity","dosage"], "properties": { "drug_id": { "type": "integer" }, "quantity": { "type": "integer" }, "dosage": { "type": "string" }, "instructions": { "type": "string" } } } } } } } } }, "responses": { "200": { "description": "处方" } } }, "get": { "tags": ["医生端-病历与处方"], "summary": "历史处方列表", "parameters": [{ "name": "page", "in": "query", "schema": { "type": "integer" } }, { "name": "per_page", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "分页" } } } },
    "/doctor/prescriptions/{id}": { "get": { "tags": ["医生端-病历与处方"], "summary": "处方详情", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "处方+患者+明细" } } } },
    "/doctor/medical-record-templates": { "post": { "tags": ["医生端-病历与处方"], "summary": "保存病历模板", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["name","symptoms","preliminary_diagnosis","treatment_plan"], "properties": { "name": { "type": "string" }, "symptoms": { "type": "string" }, "imaging_findings": { "type": "string" }, "preliminary_diagnosis": { "type": "string" }, "treatment_plan": { "type": "string" } } } } } }, "responses": { "200": { "description": "模板" } } }, "get": { "tags": ["医生端-病历与处方"], "summary": "病历模板列表", "responses": { "200": { "description": "模板列表" } } } },
    "/doctor/prescription-templates": { "post": { "tags": ["医生端-病历与处方"], "summary": "保存处方模板", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["name","items"], "properties": { "name": { "type": "string" }, "items": { "type": "array", "items": { "type": "object" } } } } } } }, "responses": { "200": { "description": "模板" } } }, "get": { "tags": ["医生端-病历与处方"], "summary": "处方模板列表", "responses": { "200": { "description": "模板列表" } } } }
  }
}
